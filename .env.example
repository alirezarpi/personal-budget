# ING via FinTS: the same values as banking-ing-transaction.env in banking-stuff.
FINTS_USER=
FINTS_PIN=
FINTS_PRODUCT_ID=
FINTS_BANK_CODE=50010517
FINTS_SERVER=https://fints.ing.de/fints/
# Only sync this account (default: every account on the login; transfers between them are ignored).
# FINTS_IBAN=DE00000000000000000000
# FINTS_ACCOUNT_NAME=Girokonto

# How often to sync, and how often the app's sync button may be used. Both default to 2 hours.
SYNC_INTERVAL_MINUTES=120
SYNC_MANUAL_COOLDOWN_MINUTES=120
TZ=Europe/Berlin

# Show the design's demo month instead of your bank data.
# MONAT_DEMO=1
